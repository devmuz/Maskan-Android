<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing is backed up or transferred. App data includes the Firebase Auth
   session and the saved role; restoring them onto a reinstall or a new
   device could sign the user into an old (or someone else's) account.
   All real data lives in Firestore and reloads after sign-in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
